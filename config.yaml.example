# Essensys Backend Server Configuration
# This is an example configuration file. Copy to config.yaml and customize.

server:
  # Port 80 is MANDATORY for BP_MQX_ETH client compatibility
  # The firmware is hardcoded to connect to port 80
  port: 80
  
  # HTTP server timeouts
  read_timeout: 10s
  write_timeout: 10s
  idle_timeout: 60s

auth:
  # Enable/disable authentication (disabled by default)
  enabled: false
  
  # Client credentials (matricule: key pairs)
  # The matricule is typically the MAC address + server key
  clients:
    testclient: testpass
    # Add more clients as needed:
    # 123456789abcdef: fedcba0987654321

logging:
  # Log level: debug, info, warn, error
  level: info
  
  # Log format: text or json
  format: text

mqtt:
  # Enable/disable MQTT integration (disabled by default)
  enabled: false
  
  # MQTT broker address
  broker: "tcp://localhost:1883"
  
  # MQTT authentication
  username: "essensys"
  password: "essensys_mqtt_password"
  
  # MQTT client ID
  client_id: "essensys-backend"

unifi:
  # Enable/disable UniFi Protect integration (disabled by default)
  enabled: false
  
  # UniFi Protect base URL (UDM Pro IP address)
  base_url: "https://192.168.0.1"
  
  # UniFi Protect API key
  # Generate API key from UniFi Protect web interface:
  # Settings > Users > [Your User] > API Access > Generate API Key
  api_key: "your_unifi_api_key_here"
  
  # Optional: Username and password for session authentication
  # Required if API key alone doesn't work (some UniFi versions need session auth)
  # If MFA is enabled, you may need to use a local account or disable MFA temporarily
  username: ""
  password: ""

# IAM LAN (OpenSpec 2026-06.017) — comptes mon.essensys.local
lan_iam:
  enabled: false
  session_ttl_hours: 168
  secure_cookie: true
  bootstrap_token_file: /opt/data/config/lan_bootstrap.token
  passive_auth_capture: false
